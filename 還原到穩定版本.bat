@echo off
chcp 65001 >nul
echo =======================================================
echo          rooPlayer 系統一鍵還原精靈
echo =======================================================
echo.
echo 注意：此操作將會捨棄所有未提交的修改，
echo 並強制將程式還原至【v2.2.0-stable】穩定還原點。
echo （包含 NOW PLAYING 播放進度條上方的即時頻譜視覺化（由升頻引擎來源音訊直接驅動，64條對數頻段HiDPI頻譜）、全介面標籤清理（總覽/播放頁/DSP設定/音訊路徑/標題列的小標籤與註解、資料庫已連線徽章）、歌曲清單行距縮小且YouTube圖示改為名稱右側獨立欄位、全程式移除Roon與HQPlayer字樣改寫為中性技術描述以避版權爭議、說明頁面依最新功能全面更新（七種濾波相位、2/5/7階調變、平行漸進轉換、Range反壓串流、MSB-first DSF）；引擎核心維持 v2.1.0 全部修正：多相FIR預計算、平行調變8 worker、CPU節流、真實暖機分段接續）
echo.
set /p confirm="確定要進行還原嗎？(輸入 Y 確認，其他取消): "

if /i "%confirm%"=="Y" (
    echo.
    echo 正在還原...
    git reset --hard v2.2.0-stable
    git clean -fd
    echo.
    echo =======================================================
    echo   [✓] 程式已成功還原至 v2.2.0-stable 穩定還原點！
    echo =======================================================
) else (
    echo.
    echo 已取消還原操作。
)

echo.
pause
