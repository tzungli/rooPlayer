@echo off
chcp 65001 >nul
echo =======================================================
echo          rooPlayer 程式版本還原精靈
echo =======================================================
echo.
echo 注意：此操作將會捨棄所有尚未提交的修改，
echo 並強制將程式重設還原至【v1.3.0-stable】穩定還原點。
echo （包含全頁面專輯檢視、藝人生活誌、每日推薦、最近聆聽等功能）
echo.
set /p confirm="確定要進行還原嗎？(輸入 Y 確認，其他鍵取消): "

if /i "%confirm%"=="Y" (
    echo.
    echo 正在執行還原...
    git reset --hard v1.3.0-stable
    git clean -fd
    echo.
    echo =======================================================
    echo   [完成] 程式已成功還原至 v1.3.0-stable 穩定還原點！
    echo =======================================================
) else (
    echo.
    echo 已取消還原操作。
)

echo.
pause
