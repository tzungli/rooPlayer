@echo off
chcp 65001 >nul
echo =======================================================
echo          rooPlayer 程式版本還原精靈
echo =======================================================
echo.
echo 注意：此操作將會放棄所有未提交的修改，
echo 並強制將程式代碼還原至【v1.2.0-stable】穩定版本還原點。
echo （包含播放紀錄 100 首、專輯介紹折疊與多段深度、極簡元資料排版）
echo.
set /p confirm="確認要進行還原嗎？(輸入 Y 確認，其他鍵取消): "

if /i "%confirm%"=="Y" (
    echo.
    echo 正在執行還原...
    git reset --hard v1.2.0-stable
    git clean -fd
    echo.
    echo =======================================================
    echo   [完成] 程式已成功還原至 v1.2.0-stable 穩定還原點！
    echo =======================================================
) else (
    echo.
    echo 已取消還原操作。
)

echo.
pause
