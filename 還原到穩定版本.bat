@echo off
chcp 65001 >nul
echo =======================================================
echo          rooPlayer 系統一鍵還原精靈
echo =======================================================
echo.
echo 注意：此操作將會捨棄所有未提交的修改，
echo 並強制將程式還原至【v0.1.0】穩定還原點。
echo （功能完整可用版本：Native DSP 升頻引擎七種濾波相位、1-bit DSD 調變 2/5/7 階平行漸進轉換與真實暖機、參數化等化器 PEQ 含 6 組自訂儲存槽、卷積濾波器 IR 脈衝響應、DLNA/UPnP 串流、TIDAL 與 KKBOX、即時頻譜視覺化、啟動還原最後播放歌曲）
echo.
set /p confirm="確定要進行還原嗎？(輸入 Y 確認，其他取消): "

if /i "%confirm%"=="Y" (
    echo.
    echo 正在還原...
    git reset --hard v0.1.0
    git clean -fd
    echo.
    echo =======================================================
    echo   [✓] 程式已成功還原至 v0.1.0 穩定還原點！
    echo =======================================================
) else (
    echo.
    echo 已取消還原操作。
)

echo.
pause
