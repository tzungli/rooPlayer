@echo off
chcp 65001 >nul
echo =======================================================
echo          rooPlayer 系統一鍵還原精靈
echo =======================================================
echo.
echo 注意：此操作將會捨棄所有未提交的修改，
echo 並強制將程式還原至【v1.6.0-stable】穩定還原點。
echo （包含 TIDAL 專屬獨立導覽分頁、官方精選歌單、母帶製作規格卡片整合至封面旁、總覽藝人誌與最新新增 TIDAL 整合、KKBOX 修正與封面點選修復）
echo.
set /p confirm="確定要進行還原嗎？(輸入 Y 確認，其他取消): "

if /i "%confirm%"=="Y" (
    echo.
    echo 正在還原...
    git reset --hard v1.6.0-stable
    git clean -fd
    echo.
    echo =======================================================
    echo   [✓] 程式已成功還原至 v1.6.0-stable 穩定還原點！
    echo =======================================================
) else (
    echo.
    echo 已取消還原操作。
)

echo.
pause
