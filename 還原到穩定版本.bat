@echo off
chcp 65001 >nul
echo =======================================================
echo          rooPlayer 系統一鍵還原精靈
echo =======================================================
echo.
echo 注意：此操作將會捨棄所有未提交的修改，
echo 並強制將程式還原至【v1.9.0-stable】穩定還原點。
echo （包含 修正5/7階DSD調變器噪音問題：重新綜合為穩定CIFFR拓撲與係數、帶內噪訊降至2階基線的1/3、7階增益衰減修復、各階音量差縮小、漸進與整檔編碼位元一致、worker端對端驗證通過）
echo.
set /p confirm="確定要進行還原嗎？(輸入 Y 確認，其他取消): "

if /i "%confirm%"=="Y" (
    echo.
    echo 正在還原...
    git reset --hard v1.9.0-stable
    git clean -fd
    echo.
    echo =======================================================
    echo   [✓] 程式已成功還原至 v1.9.0-stable 穩定還原點！
    echo =======================================================
) else (
    echo.
    echo 已取消還原操作。
)

echo.
pause
