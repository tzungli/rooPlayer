@echo off
chcp 65001 >nul
echo =======================================================
echo          rooPlayer 系統一鍵還原精靈
echo =======================================================
echo.
echo 注意：此操作將會捨棄所有未提交的修改，
echo 並強制將程式還原至【v2.0.0-stable】穩定還原點。
echo （包含 新增四種升頻濾波器：gauss-long/gauss-min/poly-ext2/HQ PS-EXT2直譯FIR、修正5/7階DSD調變升頻串流DLNA播放數秒中斷問題：改為最多4段平行調變、生成速度提升約4倍、段邊界暖機接續不可聽、第一段與整檔編碼位元一致、關閉應用程式時DLNA設備立即停止不再播放缓冲剩餘音訊、播放列表面板顯示歌手-歌曲名稱、音訊路徑面板欄寬優化）
echo.
set /p confirm="確定要進行還原嗎？(輸入 Y 確認，其他取消): "

if /i "%confirm%"=="Y" (
    echo.
    echo 正在還原...
    git reset --hard v2.0.0-stable
    git clean -fd
    echo.
    echo =======================================================
    echo   [✓] 程式已成功還原至 v2.0.0-stable 穩定還原點！
    echo =======================================================
) else (
    echo.
    echo 已取消還原操作。
)

echo.
pause
